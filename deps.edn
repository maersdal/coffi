{:paths ["src/clj" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        insn/insn {:mvn/version "0.5.4"}}

 :aliases
 {:dev {:extra-paths ["."]
        :extra-deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"} 
                     com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"}
                     criterium/criterium {:mvn/version "0.4.6"}} 
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :test {:extra-paths ["test/clj"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner"
                       :sha "3f288f1f16d167723ad87cc35b1dfee3c1681e10"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :exec-fn cognitect.test-runner.api/test} 
  

  :build {:replace-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                         io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build
          :exec-fn run-tasks}
  :install {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
            :exec-fn deps-deploy.deps-deploy/deploy
            :exec-args {:installer :local :artifact "target/coffi.jar"
                        :pom-file "target/pom.xml"}}
  }}
