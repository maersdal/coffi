# Runs the examples/benchmarks JVM vs native-image comparison (Linux x64).
#
#   docker build -f Dockerfile.bench -t coffi-bench .
#   docker run --rm coffi-bench
# Community edition by default; for PGO and the G1 collector use:
#   --build-arg BASE_IMAGE=container-registry.oracle.com/graalvm/native-image:25
ARG BASE_IMAGE=ghcr.io/graalvm/native-image-community:25
FROM ${BASE_IMAGE}

RUN microdnf install -y bash curl git gcc && microdnf clean all

RUN curl -fsSL -o /tmp/clojure-install.sh \
      https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh \
 && bash /tmp/clojure-install.sh \
 && rm /tmp/clojure-install.sh

WORKDIR /coffi
COPY deps.edn build.clj ./
COPY src src
COPY resources resources
COPY examples examples

WORKDIR /coffi/examples/benchmarks
RUN clojure -P

ENTRYPOINT ["/bin/bash", "build.sh"]
