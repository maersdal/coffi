# Runs the examples/benchmarks JVM vs native-image comparison (Linux x64).
#
#   docker build -f Dockerfile.bench -t coffi-bench .
#   docker run --rm coffi-bench
# Community edition by default; for PGO and the G1 collector use:
#   --build-arg BASE_IMAGE=container-registry.oracle.com/graalvm/native-image:25
# The native-image build happens inside `docker run`, so tuning knobs are
# runtime env vars (see BENCHMARKS.md), e.g. PGO and coffi's eager downcall
# handles (GraalVM 25.1+ only, e.g.
# --build-arg BASE_IMAGE=ghcr.io/graalvm/native-image-community:25i1;
# GraalVM 25.0.x fails the image build with the flag):
#   docker run --rm -e EXTRA_NATIVE_OPTS=-J-Dcoffi.ffi.eager-native-image-handles=true coffi-bench
ARG BASE_IMAGE=ghcr.io/graalvm/native-image-community:25
FROM ${BASE_IMAGE}

RUN microdnf install -y bash curl git gcc && microdnf clean all

RUN curl -fsSL -o /tmp/clojure-install.sh \
      https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh \
 && bash /tmp/clojure-install.sh \
 && rm /tmp/clojure-install.sh

ARG BB_VERSION=1.12.218
RUN curl -fsSL https://github.com/babashka/babashka/releases/download/v${BB_VERSION}/babashka-${BB_VERSION}-linux-amd64-static.tar.gz \
    | tar -xz -C /usr/local/bin

WORKDIR /coffi
COPY deps.edn build.clj ./
COPY src src
COPY resources resources
COPY examples examples

WORKDIR /coffi/examples/benchmarks
RUN clojure -P

ENTRYPOINT ["bb", "build.bb"]
